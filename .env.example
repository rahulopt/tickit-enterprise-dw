# Copy to .env and replace these values before sourcing; .env is Git-ignored.
# Use IAM roles / the normal AWS credential chain. Do not put credentials here.
TICKIT_BUCKET=REPLACE_WITH_YOUR_S3_BUCKET
STATE_MACHINE_ARN=REPLACE_WITH_YOUR_STATE_MACHINE_ARN
TICKIT_WORKFLOW_DB_USER=IAMR:REPLACE_WITH_YOUR_WORKFLOW_ROLE
AWS_DEFAULT_REGION=REPLACE_WITH_YOUR_AWS_REGION
