{
  "Comment": "TICKIT: six parallel Bronze-to-Silver tasks, atomic Redshift staging, dimensions, facts, SNS alerts",
  "StartAt": "ParallelBronzeToSilver",
  "States": {
    "ParallelBronzeToSilver": {
      "Type": "Parallel",
      "Branches": [
        {
          "StartAt": "CategoryETL",
          "States": {
            "CategoryETL": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "arn:aws:lambda:ap-south-1:519749210589:function:tickit-category-etl",
                "InvocationType": "RequestResponse"
              },
              "ResultPath": "$.category_result",
              "Retry": [
                {
                  "ErrorEquals": [
                    "Lambda.ServiceException"
                  ],
                  "IntervalSeconds": 30,
                  "MaxAttempts": 2,
                  "BackoffRate": 2.0
                }
              ],
              "End": true
            }
          }
        },
        {
          "StartAt": "VenueETL",
          "States": {
            "VenueETL": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "arn:aws:lambda:ap-south-1:519749210589:function:tickit-venue-etl",
                "InvocationType": "RequestResponse"
              },
              "ResultPath": "$.venue_result",
              "Retry": [
                {
                  "ErrorEquals": [
                    "Lambda.ServiceException"
                  ],
                  "IntervalSeconds": 30,
                  "MaxAttempts": 2,
                  "BackoffRate": 2.0
                }
              ],
              "End": true
            }
          }
        },
        {
          "StartAt": "UsersETL",
          "States": {
            "UsersETL": {
              "Type": "Task",
              "Resource": "arn:aws:states:::glue:startJobRun.sync",
              "Parameters": {
                "JobName": "tickit-users-etl"
              },
              "ResultPath": "$.users_result",
              "Retry": [
                {
                  "ErrorEquals": [
                    "Glue.AmazonGlueException"
                  ],
                  "IntervalSeconds": 60,
                  "MaxAttempts": 1,
                  "BackoffRate": 2.0
                }
              ],
              "End": true
            }
          }
        },
        {
          "StartAt": "EventsETL",
          "States": {
            "EventsETL": {
              "Type": "Task",
              "Resource": "arn:aws:states:::glue:startJobRun.sync",
              "Parameters": {
                "JobName": "tickit-events-etl"
              },
              "ResultPath": "$.events_result",
              "Retry": [
                {
                  "ErrorEquals": [
                    "Glue.AmazonGlueException"
                  ],
                  "IntervalSeconds": 60,
                  "MaxAttempts": 1,
                  "BackoffRate": 2.0
                }
              ],
              "End": true
            }
          }
        },
        {
          "StartAt": "ListingsETL",
          "States": {
            "ListingsETL": {
              "Type": "Task",
              "Resource": "arn:aws:states:::glue:startJobRun.sync",
              "Parameters": {
                "JobName": "tickit-listings-etl"
              },
              "ResultPath": "$.listings_result",
              "Retry": [
                {
                  "ErrorEquals": [
                    "Glue.AmazonGlueException"
                  ],
                  "IntervalSeconds": 60,
                  "MaxAttempts": 1,
                  "BackoffRate": 2.0
                }
              ],
              "End": true
            }
          }
        },
        {
          "StartAt": "SalesETL",
          "States": {
            "SalesETL": {
              "Type": "Task",
              "Resource": "arn:aws:states:::glue:startJobRun.sync",
              "Parameters": {
                "JobName": "tickit-sales-etl"
              },
              "ResultPath": "$.sales_result",
              "Retry": [
                {
                  "ErrorEquals": [
                    "Glue.AmazonGlueException"
                  ],
                  "IntervalSeconds": 60,
                  "MaxAttempts": 1,
                  "BackoffRate": 2.0
                }
              ],
              "End": true
            }
          }
        }
      ],
      "ResultPath": "$.etl_results",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "NotifyETLFailed"
        }
      ],
      "Next": "LoadStaging"
    },
    "LoadStaging": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:redshiftdata:executeStatement",
      "Parameters": {
        "Database": "tickit",
        "WorkgroupName": "ent-dw-1",
        "Sql": "CALL sp_load_staging('ent-dw-ticket-sales-519749210589', 'arn:aws:iam::519749210589:role/RedshiftServerlessRole')"
      },
      "ResultPath": "$.staging_exec",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "NotifyStagingFailed"
        }
      ],
      "Next": "WaitForStaging"
    },
    "WaitForStaging": {
      "Type": "Wait",
      "Seconds": 120,
      "Next": "CheckStagingStatus"
    },
    "CheckStagingStatus": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:redshiftdata:describeStatement",
      "Parameters": {
        "Id.$": "$.staging_exec.Id"
      },
      "ResultPath": "$.staging_status",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "NotifyStagingFailed"
        }
      ],
      "Next": "IsStagingDone",
      "Retry": [
        {
          "ErrorEquals": [
            "RedshiftData.ThrottlingException",
            "RedshiftData.InternalServerException",
            "States.TaskFailed"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ]
    },
    "IsStagingDone": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.staging_status.Status",
          "StringEquals": "FINISHED",
          "Next": "LoadDimensions"
        },
        {
          "Variable": "$.staging_status.Status",
          "StringEquals": "FAILED",
          "Next": "CaptureStagingFailure"
        },
        {
          "Variable": "$.staging_status.Status",
          "StringEquals": "ABORTED",
          "Next": "CaptureStagingFailure"
        }
      ],
      "Default": "WaitForStaging"
    },
    "LoadDimensions": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:redshiftdata:executeStatement",
      "Parameters": {
        "Database": "tickit",
        "WorkgroupName": "ent-dw-1",
        "Sql": "CALL sp_load_dimensions(CURRENT_DATE)"
      },
      "ResultPath": "$.dim_exec",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "NotifyDimensionsFailed"
        }
      ],
      "Next": "WaitForDimensions"
    },
    "WaitForDimensions": {
      "Type": "Wait",
      "Seconds": 60,
      "Next": "CheckDimensionsStatus"
    },
    "CheckDimensionsStatus": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:redshiftdata:describeStatement",
      "Parameters": {
        "Id.$": "$.dim_exec.Id"
      },
      "ResultPath": "$.dim_status",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "NotifyDimensionsFailed"
        }
      ],
      "Next": "IsDimensionsDone",
      "Retry": [
        {
          "ErrorEquals": [
            "RedshiftData.ThrottlingException",
            "RedshiftData.InternalServerException",
            "States.TaskFailed"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ]
    },
    "IsDimensionsDone": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.dim_status.Status",
          "StringEquals": "FINISHED",
          "Next": "LoadFacts"
        },
        {
          "Variable": "$.dim_status.Status",
          "StringEquals": "FAILED",
          "Next": "CaptureDimensionsFailure"
        },
        {
          "Variable": "$.dim_status.Status",
          "StringEquals": "ABORTED",
          "Next": "CaptureDimensionsFailure"
        }
      ],
      "Default": "WaitForDimensions"
    },
    "LoadFacts": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:redshiftdata:executeStatement",
      "Parameters": {
        "Database": "tickit",
        "WorkgroupName": "ent-dw-1",
        "Sql": "CALL sp_load_facts(CURRENT_DATE)"
      },
      "ResultPath": "$.fact_exec",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "NotifyFactsFailed"
        }
      ],
      "Next": "WaitForFacts"
    },
    "WaitForFacts": {
      "Type": "Wait",
      "Seconds": 180,
      "Next": "CheckFactsStatus"
    },
    "CheckFactsStatus": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:redshiftdata:describeStatement",
      "Parameters": {
        "Id.$": "$.fact_exec.Id"
      },
      "ResultPath": "$.fact_status",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "NotifyFactsFailed"
        }
      ],
      "Next": "IsFactsDone",
      "Retry": [
        {
          "ErrorEquals": [
            "RedshiftData.ThrottlingException",
            "RedshiftData.InternalServerException",
            "States.TaskFailed"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ]
    },
    "IsFactsDone": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.fact_status.Status",
          "StringEquals": "FINISHED",
          "Next": "NotifySuccess"
        },
        {
          "Variable": "$.fact_status.Status",
          "StringEquals": "FAILED",
          "Next": "CaptureFactsFailure"
        },
        {
          "Variable": "$.fact_status.Status",
          "StringEquals": "ABORTED",
          "Next": "CaptureFactsFailure"
        }
      ],
      "Default": "WaitForFacts"
    },
    "NotifySuccess": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "arn:aws:sns:ap-south-1:519749210589:tickit-etl-notifications",
        "Subject": "TICKIT Pipeline SUCCESS",
        "Message": "Pipeline completed! All 6 ETL jobs, staging, SCD Type 2 dimensions, and facts loaded successfully."
      },
      "Next": "PipelineSuccess",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "PipelineFailed"
        }
      ]
    },
    "NotifyETLFailed": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "arn:aws:sns:ap-south-1:519749210589:tickit-etl-notifications",
        "Subject": "TICKIT Pipeline FAILED - ETL",
        "Message.$": "States.JsonToString($.error)"
      },
      "Next": "PipelineFailed",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "PipelineFailed"
        }
      ]
    },
    "NotifyStagingFailed": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "arn:aws:sns:ap-south-1:519749210589:tickit-etl-notifications",
        "Subject": "TICKIT Pipeline FAILED - Staging",
        "Message.$": "States.JsonToString($.error)"
      },
      "Next": "PipelineFailed",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "PipelineFailed"
        }
      ]
    },
    "NotifyDimensionsFailed": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "arn:aws:sns:ap-south-1:519749210589:tickit-etl-notifications",
        "Subject": "TICKIT Pipeline FAILED - Dimensions",
        "Message.$": "States.JsonToString($.error)"
      },
      "Next": "PipelineFailed",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "PipelineFailed"
        }
      ]
    },
    "NotifyFactsFailed": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "arn:aws:sns:ap-south-1:519749210589:tickit-etl-notifications",
        "Subject": "TICKIT Pipeline FAILED - Facts",
        "Message.$": "States.JsonToString($.error)"
      },
      "Next": "PipelineFailed",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "PipelineFailed"
        }
      ]
    },
    "PipelineSuccess": {
      "Type": "Succeed"
    },
    "PipelineFailed": {
      "Type": "Fail",
      "Error": "PipelineError",
      "Cause": "One or more stages failed"
    },
    "CaptureStagingFailure": {
      "Type": "Pass",
      "Parameters": {
        "Error": "RedshiftStatementFailed",
        "stage": "staging",
        "status.$": "$.staging_status.Status",
        "statement_id.$": "$.staging_exec.Id"
      },
      "ResultPath": "$.error",
      "Next": "NotifyStagingFailed"
    },
    "CaptureDimensionsFailure": {
      "Type": "Pass",
      "Parameters": {
        "Error": "RedshiftStatementFailed",
        "stage": "dimensions",
        "status.$": "$.dim_status.Status",
        "statement_id.$": "$.dim_exec.Id"
      },
      "ResultPath": "$.error",
      "Next": "NotifyDimensionsFailed"
    },
    "CaptureFactsFailure": {
      "Type": "Pass",
      "Parameters": {
        "Error": "RedshiftStatementFailed",
        "stage": "facts",
        "status.$": "$.fact_status.Status",
        "statement_id.$": "$.fact_exec.Id"
      },
      "ResultPath": "$.error",
      "Next": "NotifyFactsFailed"
    }
  },
  "TimeoutSeconds": 10800
}
