{
  "LambdaFunctionConfigurations": [
    {
      "Id": "isolated-versioned-batch-manifest",
      "LambdaFunctionArn": "{{ISOLATED_INGRESS_ARN}}",
      "Events": ["s3:ObjectCreated:Put"],
      "Filter": {"Key": {"FilterRules": [
        {"Name": "prefix", "Value": "tickit-v2/batches/"},
