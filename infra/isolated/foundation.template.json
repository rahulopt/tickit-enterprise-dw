{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "TICKIT ISOLATED ONLY; deploy only after approval",
  "Parameters": {
    "TestName": {
      "Type": "String",
      "AllowedPattern": "tickit-it-[a-z0-9-]{3,24}"
    },
    "ProductionAccountId": {
      "Type": "String",
      "AllowedPattern": "[0-9]{12}"
    }
  },
  "Conditions": {
    "IsolatedAccount": {
      "Fn::And": [
        {
          "Fn::Not": [
            {
              "Fn::Equals": [
                {
                  "Ref": "AWS::AccountId"
                },
                {
                  "Ref": "ProductionAccountId"
                }
              ]
            }
          ]
        },
        {
          "Fn::Equals": [
            {
              "Ref": "AWS::Region"
            },
            "us-east-1"
          ]
        }
      ]
    }
  },
  "Resources": {
    "Bucket": {
      "Type": "AWS::S3::Bucket",
      "Condition": "IsolatedAccount",
      "Properties": {
        "BucketName": {
          "Fn::Sub": "${TestName}-${AWS::AccountId}-${AWS::Region}"
        },
        "VersioningConfiguration": {
          "Status": "Enabled"
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "IgnorePublicAcls": true,
          "BlockPublicPolicy": true,
          "RestrictPublicBuckets": true
        },
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "abort-incomplete",
              "Status": "Enabled",
              "AbortIncompleteMultipartUpload": {
                "DaysAfterInitiation": 1
              }
            }
          ]
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "BucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Condition": "IsolatedAccount",
      "Properties": {
        "Bucket": {
          "Ref": "Bucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "TLS",
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "Bucket",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${Bucket.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            },
            {
              "Sid": "NoBatchDelete",
              "Effect": "Deny",
              "Principal": "*",
              "Action": [
                "s3:DeleteObject",
                "s3:DeleteObjectVersion"
              ],
              "Resource": [
                {
                  "Fn::Sub": "${Bucket.Arn}/tickit-v2/batches/*/bronze/*"
                },
                {
                  "Fn::Sub": "${Bucket.Arn}/tickit-v2/batches/*/input-manifest.json"
                },
                {
                  "Fn::Sub": "${Bucket.Arn}/tickit-v2/batches/*/attempts/*/silver/*"
                },
                {
                  "Fn::Sub": "${Bucket.Arn}/tickit-v2/batches/*/attempts/*/output-manifest.json"
                },
                {
                  "Fn::Sub": "${Bucket.Arn}/tickit-v2/batches/*/attempts/*/warehouse/*"
                },
                {
                  "Fn::Sub": "${Bucket.Arn}/tickit-v2/batches/*/attempts/*/pinned-inputs/*"
                },
                {
                  "Fn::Sub": "${Bucket.Arn}/artifacts/*"
                }
              ]
            },
            {
              "Sid": "RequireCreateOnly",
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:PutObject",
              "Resource": [
                {
                  "Fn::Sub": "${Bucket.Arn}/tickit-v2/batches/*/bronze/*"
                },
                {
                  "Fn::Sub": "${Bucket.Arn}/tickit-v2/batches/*/input-manifest.json"
                },
                {
                  "Fn::Sub": "${Bucket.Arn}/tickit-v2/batches/*/attempts/*/silver/*"
                },
                {
                  "Fn::Sub": "${Bucket.Arn}/tickit-v2/batches/*/attempts/*/output-manifest.json"
                },
                {
                  "Fn::Sub": "${Bucket.Arn}/tickit-v2/batches/*/attempts/*/warehouse/*"
                },
                {
                  "Fn::Sub": "${Bucket.Arn}/tickit-v2/batches/*/attempts/*/pinned-inputs/*"
                },
                {
                  "Fn::Sub": "${Bucket.Arn}/artifacts/*"
                }
              ],
              "Condition": {
                "Null": {
                  "s3:if-none-match": "true"
                },
                "Bool": {
                  "s3:ObjectCreationOperation": "true"
                }
              }
            }
          ]
        }
      }
    },
    "Ledger": {
      "Type": "AWS::DynamoDB::Table",
      "Condition": "IsolatedAccount",
      "Properties": {
        "TableName": {
          "Fn::Sub": "${TestName}-ledger"
        },
        "BillingMode": "PAY_PER_REQUEST",
        "AttributeDefinitions": [
          {
            "AttributeName": "pk",
            "AttributeType": "S"
          },
          {
            "AttributeName": "queue_partition",
            "AttributeType": "S"
          },
          {
            "AttributeName": "queue_sort",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "pk",
            "KeyType": "HASH"
          }
        ],
        "GlobalSecondaryIndexes": [
          {
            "IndexName": "queued-batches",
            "KeySchema": [
              {
                "AttributeName": "queue_partition",
                "KeyType": "HASH"
              },
              {
                "AttributeName": "queue_sort",
                "KeyType": "RANGE"
              }
            ],
            "Projection": {
              "ProjectionType": "ALL"
            }
          }
        ],
        "PointInTimeRecoverySpecification": {
          "PointInTimeRecoveryEnabled": true
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "DeadQueue": {
      "Type": "AWS::SQS::Queue",
      "Condition": "IsolatedAccount",
      "Properties": {
        "QueueName": {
          "Fn::Sub": "${TestName}-dead.fifo"
        },
        "FifoQueue": true,
        "MessageRetentionPeriod": 1209600,
        "SqsManagedSseEnabled": true
      }
    },
    "BatchQueue": {
      "Type": "AWS::SQS::Queue",
      "Condition": "IsolatedAccount",
      "Properties": {
        "QueueName": {
          "Fn::Sub": "${TestName}-batches.fifo"
        },
        "FifoQueue": true,
        "MessageRetentionPeriod": 1209600,
        "VisibilityTimeout": 60,
        "SqsManagedSseEnabled": true,
        "RedrivePolicy": {
          "deadLetterTargetArn": {
            "Fn::GetAtt": [
              "DeadQueue",
              "Arn"
            ]
          },
          "maxReceiveCount": 5
        }
      }
    },
    "Topic": {
      "Type": "AWS::SNS::Topic",
      "Condition": "IsolatedAccount",
      "Properties": {
        "TopicName": {
          "Fn::Sub": "${TestName}-notifications"
        }
      }
    },
    "DeliveryQueue": {
      "Type": "AWS::SQS::Queue",
      "Condition": "IsolatedAccount",
      "Properties": {
        "QueueName": {
          "Fn::Sub": "${TestName}-notifications"
        },
        "MessageRetentionPeriod": 86400,
        "SqsManagedSseEnabled": true
      }
    },
    "DeliveryPolicy": {
      "Type": "AWS::SQS::QueuePolicy",
      "Condition": "IsolatedAccount",
      "Properties": {
        "Queues": [
          {
            "Ref": "DeliveryQueue"
          }
        ],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "sns.amazonaws.com"
              },
              "Action": "sqs:SendMessage",
              "Resource": {
                "Fn::GetAtt": [
                  "DeliveryQueue",
                  "Arn"
                ]
              },
              "Condition": {
                "ArnEquals": {
                  "aws:SourceArn": {
                    "Ref": "Topic"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "Subscription": {
      "Type": "AWS::SNS::Subscription",
      "Condition": "IsolatedAccount",
      "Properties": {
        "TopicArn": {
          "Ref": "Topic"
        },
        "Protocol": "sqs",
        "Endpoint": {
          "Fn::GetAtt": [
            "DeliveryQueue",
            "Arn"
          ]
        },
        "RawMessageDelivery": true
      }
    },
    "CopyRole": {
      "Type": "AWS::IAM::Role",
      "Condition": "IsolatedAccount",
      "Properties": {
        "RoleName": {
          "Fn::Sub": "${TestName}-CopyRole"
        },
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": [
                  "redshift.amazonaws.com",
                  "redshift-serverless.amazonaws.com"
                ]
              },
              "Action": "sts:AssumeRole",
              "Condition": {
                "StringEquals": {
                  "aws:SourceAccount": {
                    "Ref": "AWS::AccountId"
                  }
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "isolated-only",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject"
                  ],
                  "Resource": {
                    "Fn::Sub": "${Bucket.Arn}/tickit-v2/batches/*/attempts/*/warehouse/*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetBucketLocation"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "Bucket",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:ListBucket"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "Bucket",
                      "Arn"
                    ]
                  },
                  "Condition": {
                    "StringLike": {
                      "s3:prefix": [
                        "tickit-v2/batches/*/attempts/*/warehouse/*"
                      ]
                    }
                  }
                }
              ]
            }
          }
        ]
      }
    }
  },
  "Outputs": {
    "Bucket": {
      "Condition": "IsolatedAccount",
      "Value": {
        "Ref": "Bucket"
      },
      "Export": {
        "Name": {
          "Fn::Sub": "${TestName}-Bucket"
        }
      }
    },
    "BucketArn": {
      "Condition": "IsolatedAccount",
      "Value": {
        "Fn::GetAtt": [
          "Bucket",
          "Arn"
        ]
      },
      "Export": {
        "Name": {
          "Fn::Sub": "${TestName}-BucketArn"
        }
      }
    },
    "Table": {
      "Condition": "IsolatedAccount",
      "Value": {
        "Ref": "Ledger"
      },
      "Export": {
        "Name": {
          "Fn::Sub": "${TestName}-Table"
        }
      }
    },
    "TableArn": {
      "Condition": "IsolatedAccount",
      "Value": {
        "Fn::GetAtt": [
          "Ledger",
          "Arn"
        ]
      },
      "Export": {
        "Name": {
          "Fn::Sub": "${TestName}-TableArn"
        }
      }
    },
    "QueueUrl": {
      "Condition": "IsolatedAccount",
      "Value": {
        "Ref": "BatchQueue"
      },
      "Export": {
        "Name": {
          "Fn::Sub": "${TestName}-QueueUrl"
        }
      }
    },
    "QueueArn": {
      "Condition": "IsolatedAccount",
      "Value": {
        "Fn::GetAtt": [
          "BatchQueue",
          "Arn"
        ]
      },
      "Export": {
        "Name": {
          "Fn::Sub": "${TestName}-QueueArn"
        }
      }
    },
    "TopicArn": {
      "Condition": "IsolatedAccount",
      "Value": {
        "Ref": "Topic"
      },
      "Export": {
        "Name": {
          "Fn::Sub": "${TestName}-TopicArn"
        }
      }
    },
    "DeliveryQueueUrl": {
      "Condition": "IsolatedAccount",
      "Value": {
        "Ref": "DeliveryQueue"
      },
      "Export": {
        "Name": {
          "Fn::Sub": "${TestName}-DeliveryQueueUrl"
        }
      }
    },
    "CopyRoleArn": {
      "Condition": "IsolatedAccount",
      "Value": {
        "Fn::GetAtt": [
          "CopyRole",
          "Arn"
        ]
      },
      "Export": {
        "Name": {
          "Fn::Sub": "${TestName}-CopyRoleArn"
        }
      }
    }
  }
}
