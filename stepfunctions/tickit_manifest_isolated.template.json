{
  "Comment": "Isolated manifest integration only; no task releases a lease.",
  "StartAt": "Validate",
  "TimeoutSeconds": 900,
  "States": {
    "Validate": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "{{CONTROLLER_ARN}}",
        "Payload": {
          "action": "validate",
          "request.$": "$"
        }
      },
      "OutputPath": "$.Payload",
      "Next": "SixBranches",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "NotifyFailure"
        }
      ]
    },
    "SixBranches": {
      "Type": "Parallel",
      "Branches": [
        {
          "StartAt": "Identity",
          "States": {
            "Identity": {
              "Type": "Pass",
              "Parameters": {
                "request.$": "$",
                "task_run_id.$": "States.UUID()"
              },
              "Next": "Submit"
            },
            "Submit": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "{{CONTROLLER_ARN}}",
                "Payload": {
                  "action": "submit_branch",
                  "request.$": "$.request",
                  "dataset": "category",
                  "task_run_id.$": "$.task_run_id"
                }
              },
              "ResultSelector": {
                "payload.$": "$.Payload"
              },
              "ResultPath": "$.result_envelope",
              "Next": "Choose"
            },
            "Wait": {
              "Type": "Wait",
              "Seconds": 10,
              "Next": "Poll"
            },
            "Poll": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "{{CONTROLLER_ARN}}",
                "Payload": {
                  "action": "poll_branch",
                  "request.$": "$.request",
                  "dataset": "category",
                  "task_run_id.$": "$.task_run_id"
                }
              },
              "ResultSelector": {
                "payload.$": "$.Payload"
              },
              "ResultPath": "$.result_envelope",
              "Next": "Choose"
            },
            "Choose": {
              "Type": "Choice",
              "Choices": [
                {
                  "Variable": "$.result_envelope.payload.status",
                  "StringEquals": "SUCCEEDED",
                  "Next": "Result"
                },
                {
                  "Variable": "$.result_envelope.payload.status",
                  "StringEquals": "RUNNING",
                  "Next": "Wait"
                }
              ],
              "Default": "Failed"
            },
            "Result": {
              "Type": "Pass",
              "Parameters": {
                "dataset": "category",
                "descriptor.$": "$.result_envelope.payload.descriptor"
              },
              "End": true
            },
            "Failed": {
              "Type": "Fail",
              "Error": "ETLFailed",
              "Cause": "category failed; watchdog must drain children."
            }
          }
        },
        {
          "StartAt": "Identity",
          "States": {
            "Identity": {
              "Type": "Pass",
              "Parameters": {
                "request.$": "$",
                "task_run_id.$": "States.UUID()"
              },
              "Next": "Submit"
            },
            "Submit": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "{{CONTROLLER_ARN}}",
                "Payload": {
                  "action": "submit_branch",
                  "request.$": "$.request",
                  "dataset": "venue",
                  "task_run_id.$": "$.task_run_id"
                }
              },
              "ResultSelector": {
                "payload.$": "$.Payload"
              },
              "ResultPath": "$.result_envelope",
              "Next": "Choose"
            },
            "Wait": {
              "Type": "Wait",
              "Seconds": 10,
              "Next": "Poll"
            },
            "Poll": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "{{CONTROLLER_ARN}}",
                "Payload": {
