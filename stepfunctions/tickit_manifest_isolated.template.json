                  "request.$": "$.request",
                  "dataset": "venue",
                  "task_run_id.$": "$.task_run_id"
                }
              },
              "ResultSelector": {
                "payload.$": "$.Payload"
              },
              "ResultPath": "$.result_envelope",
              "Next": "Choose"
            },
            "Choose": {
              "Type": "Choice",
              "Choices": [
                {
                  "Variable": "$.result_envelope.payload.status",
                  "StringEquals": "SUCCEEDED",
                  "Next": "Result"
                },
                {
                  "Variable": "$.result_envelope.payload.status",
                  "StringEquals": "RUNNING",
                  "Next": "Wait"
                }
              ],
              "Default": "Failed"
            },
            "Result": {
              "Type": "Pass",
              "Parameters": {
                "dataset": "venue",
                "descriptor.$": "$.result_envelope.payload.descriptor"
              },
              "End": true
            },
            "Failed": {
              "Type": "Fail",
              "Error": "ETLFailed",
              "Cause": "venue failed; watchdog must drain children."
            }
          }
        },
        {
          "StartAt": "Identity",
          "States": {
            "Identity": {
              "Type": "Pass",
              "Parameters": {
                "request.$": "$",
                "task_run_id.$": "States.UUID()"
              },
              "Next": "Submit"
            },
            "Submit": {
              "Type": "Task",
