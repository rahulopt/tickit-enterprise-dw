            },
            "Poll": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "{{CONTROLLER_ARN}}",
                "Payload": {
                  "action": "poll_branch",
                  "request.$": "$.request",
                  "dataset": "listing",
                  "task_run_id.$": "$.task_run_id"
                }
              },
              "ResultSelector": {
                "payload.$": "$.Payload"
              },
              "ResultPath": "$.result_envelope",
              "Next": "Choose"
            },
            "Choose": {
              "Type": "Choice",
              "Choices": [
                {
                  "Variable": "$.result_envelope.payload.status",
                  "StringEquals": "SUCCEEDED",
                  "Next": "Result"
                },
                {
                  "Variable": "$.result_envelope.payload.status",
                  "StringEquals": "RUNNING",
                  "Next": "Wait"
                }
              ],
              "Default": "Failed"
            },
            "Result": {
              "Type": "Pass",
              "Parameters": {
                "dataset": "listing",
                "descriptor.$": "$.result_envelope.payload.descriptor"
              },
              "End": true
            },
            "Failed": {
              "Type": "Fail",
              "Error": "ETLFailed",
              "Cause": "listing failed; watchdog must drain children."
            }
          }
        },
        {
          "StartAt": "Identity",
          "States": {
            "Identity": {
              "Type": "Pass",
              "Parameters": {
                "request.$": "$",
                "task_run_id.$": "States.UUID()"
              },
              "Next": "Submit"
            },
            "Submit": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "{{CONTROLLER_ARN}}",
                "Payload": {
                  "action": "submit_branch",
                  "request.$": "$.request",
                  "dataset": "sales",
                  "task_run_id.$": "$.task_run_id"
                }
              },
              "ResultSelector": {
                "payload.$": "$.Payload"
              },
              "ResultPath": "$.result_envelope",
              "Next": "Choose"
            },
