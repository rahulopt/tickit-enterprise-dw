            "Poll": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "{{CONTROLLER_ARN}}",
                "Payload": {
                  "action": "poll_branch",
                  "request.$": "$.request",
                  "dataset": "users",
