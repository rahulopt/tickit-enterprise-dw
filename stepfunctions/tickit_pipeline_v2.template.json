{
  "Comment": "TICKIT V2: configurable S3 Bronze-to-Silver ETL and Redshift warehouse",
  "StartAt": "ValidateLoadDate",
  "States": {
    "ParallelBronzeToSilver": {
      "Type": "Parallel",
      "Branches": [
        {
          "StartAt": "CategoryETL",
          "States": {
            "CategoryETL": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "{{CATEGORY_LAMBDA_ARN}}",
                "InvocationType": "RequestResponse"
              },
              "ResultPath": "$.category_result",
              "Retry": [
                {
                  "ErrorEquals": [
                    "Lambda.ServiceException"
                  ],
                  "IntervalSeconds": 30,
                  "MaxAttempts": 2,
                  "BackoffRate": 2.0
                }
              ],
              "End": true
            }
          }
        },
        {
          "StartAt": "VenueETL",
          "States": {
            "VenueETL": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "{{VENUE_LAMBDA_ARN}}",
                "InvocationType": "RequestResponse"
              },
              "ResultPath": "$.venue_result",
              "Retry": [
                {
                  "ErrorEquals": [
                    "Lambda.ServiceException"
                  ],
                  "IntervalSeconds": 30,
                  "MaxAttempts": 2,
                  "BackoffRate": 2.0
                }
              ],
              "End": true
            }
          }
        },
        {
          "StartAt": "UsersETL",
          "States": {
            "UsersETL": {
              "Type": "Task",
              "Resource": "arn:aws:states:::glue:startJobRun.sync",
              "Parameters": {
                "JobName": "{{USERS_GLUE_JOB}}",
                "Arguments": {
                  "--TICKIT_BUCKET": "{{S3_BUCKET}}"
                }
              },
              "ResultPath": "$.users_result",
              "Retry": [
                {
                  "ErrorEquals": [
                    "Glue.AmazonGlueException"
                  ],
                  "IntervalSeconds": 60,
                  "MaxAttempts": 1,
                  "BackoffRate": 2.0
                }
              ],
              "End": true
            }
          }
        },
        {
          "StartAt": "EventsETL",
          "States": {
            "EventsETL": {
              "Type": "Task",
              "Resource": "arn:aws:states:::glue:startJobRun.sync",
              "Parameters": {
                "JobName": "{{EVENTS_GLUE_JOB}}",
                "Arguments": {
                  "--TICKIT_BUCKET": "{{S3_BUCKET}}"
                }
              },
              "ResultPath": "$.events_result",
              "Retry": [
                {
                  "ErrorEquals": [
                    "Glue.AmazonGlueException"
                  ],
                  "IntervalSeconds": 60,
                  "MaxAttempts": 1,
                  "BackoffRate": 2.0
                }
              ],
              "End": true
            }
          }
        },
        {
          "StartAt": "ListingsETL",
          "States": {
            "ListingsETL": {
              "Type": "Task",
              "Resource": "arn:aws:states:::glue:startJobRun.sync",
              "Parameters": {
                "JobName": "{{LISTINGS_GLUE_JOB}}",
                "Arguments": {
                  "--TICKIT_BUCKET": "{{S3_BUCKET}}"
                }
              },
              "ResultPath": "$.listings_result",
              "Retry": [
                {
                  "ErrorEquals": [
                    "Glue.AmazonGlueException"
                  ],
                  "IntervalSeconds": 60,
                  "MaxAttempts": 1,
                  "BackoffRate": 2.0
                }
              ],
              "End": true
            }
          }
        },
        {
          "StartAt": "SalesETL",
          "States": {
            "SalesETL": {
              "Type": "Task",
              "Resource": "arn:aws:states:::glue:startJobRun.sync",
              "Parameters": {
                "JobName": "{{SALES_GLUE_JOB}}",
                "Arguments": {
                  "--TICKIT_BUCKET": "{{S3_BUCKET}}"
                }
              },
              "ResultPath": "$.sales_result",
              "Retry": [
                {
                  "ErrorEquals": [
                    "Glue.AmazonGlueException"
                  ],
                  "IntervalSeconds": 60,
                  "MaxAttempts": 1,
                  "BackoffRate": 2.0
                }
              ],
              "End": true
            }
          }
        }
      ],
      "ResultPath": "$.etl_results",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "NotifyETLFailed"
        }
      ],
      "Next": "LoadStaging"
    },
    "LoadStaging": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:redshiftdata:executeStatement",
      "Parameters": {
        "Database": "{{REDSHIFT_DATABASE}}",
        "WorkgroupName": "{{REDSHIFT_WORKGROUP}}",
        "Sql": "CALL sp_load_warehouse('{{S3_BUCKET}}', '{{REDSHIFT_COPY_ROLE_ARN}}', CAST(:load_date AS DATE))",
        "Parameters": [
          {
            "Name": "load_date",
            "Value.$": "$.load_date"
          }
        ]
      },
      "ResultPath": "$.staging_exec",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "NotifyStagingFailed"
        }
      ],
      "Next": "WaitForStaging"
    },
    "WaitForStaging": {
      "Type": "Wait",
      "Seconds": "{{WAIT_STAGING_SECONDS}}",
      "Next": "CheckStagingStatus"
    },
    "CheckStagingStatus": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:redshiftdata:describeStatement",
      "Parameters": {
        "Id.$": "$.staging_exec.Id"
      },
      "ResultPath": "$.staging_status",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "NotifyStagingFailed"
        }
      ],
      "Next": "IsStagingDone",
      "Retry": [
        {
          "ErrorEquals": [
            "RedshiftData.ThrottlingException",
            "RedshiftData.InternalServerException",
            "States.TaskFailed"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ]
    },
    "IsStagingDone": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.staging_status.Status",
          "StringEquals": "FINISHED",
          "Next": "NotifySuccess"
        },
        {
          "Variable": "$.staging_status.Status",
          "StringEquals": "FAILED",
          "Next": "CaptureStagingFailure"
        },
        {
          "Variable": "$.staging_status.Status",
          "StringEquals": "ABORTED",
          "Next": "CaptureStagingFailure"
        }
      ],
      "Default": "WaitForStaging"
    },
    "NotifySuccess": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "{{SNS_TOPIC_ARN}}",
        "Subject": "TICKIT Pipeline SUCCESS",
        "Message": "TICKIT V2 completed: six ETL branches and atomic staging, daily SCD2 dimensions, and point-in-time facts."
      },
      "Next": "PipelineSuccess",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "PipelineFailed"
        }
      ]
    },
    "NotifyETLFailed": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "{{SNS_TOPIC_ARN}}",
        "Subject": "TICKIT Pipeline FAILED - ETL",
        "Message.$": "States.JsonToString($.error)"
      },
      "Next": "PipelineFailed",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "PipelineFailed"
        }
      ]
    },
    "NotifyStagingFailed": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "{{SNS_TOPIC_ARN}}",
        "Subject": "TICKIT Pipeline FAILED - Warehouse",
        "Message.$": "States.JsonToString($.error)"
      },
      "Next": "PipelineFailed",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "PipelineFailed"
        }
      ]
    },
    "PipelineSuccess": {
      "Type": "Succeed"
    },
    "PipelineFailed": {
      "Type": "Fail",
      "Error": "PipelineError",
      "Cause": "One or more stages failed"
    },
    "CaptureStagingFailure": {
      "Type": "Pass",
      "Parameters": {
        "Error": "RedshiftStatementFailed",
        "stage": "warehouse",
        "status.$": "$.staging_status.Status",
        "statement_id.$": "$.staging_exec.Id"
      },
      "ResultPath": "$.error",
      "Next": "NotifyStagingFailed"
    },
    "ValidateLoadDate": {
      "Type": "Choice",
      "Choices": [
        {
          "And": [
            {
              "Variable": "$.load_date",
              "IsPresent": true
            },
            {
              "Variable": "$.load_date",
              "IsString": true
            }
          ],
          "Next": "ParallelBronzeToSilver"
        }
      ],
      "Default": "InvalidLoadDate"
    },
    "InvalidLoadDate": {
      "Type": "Fail",
      "Error": "InvalidLoadDate",
      "Cause": "Supply load_date as YYYY-MM-DD for the source snapshot."
    }
  },
  "TimeoutSeconds": "{{WORKFLOW_TIMEOUT_SECONDS}}"
}
