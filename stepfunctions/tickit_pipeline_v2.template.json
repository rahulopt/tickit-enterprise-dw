{
  "Comment": "TICKIT V2: configurable S3 Bronze-to-Silver ETL and Redshift warehouse",
  "StartAt": "ParallelBronzeToSilver",
  "States": {
    "ParallelBronzeToSilver": {
      "Type": "Parallel",
      "Branches": [
        {
          "StartAt": "CategoryETL",
          "States": {
            "CategoryETL": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "{{CATEGORY_LAMBDA_ARN}}",
                "InvocationType": "RequestResponse"
              },
              "ResultPath": "$.category_result",
              "Retry": [
                {
                  "ErrorEquals": [
                    "Lambda.ServiceException"
                  ],
                  "IntervalSeconds": 30,
                  "MaxAttempts": 2,
                  "BackoffRate": 2.0
                }
              ],
              "End": true
            }
          }
        },
        {
          "StartAt": "VenueETL",
          "States": {
            "VenueETL": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "{{VENUE_LAMBDA_ARN}}",
                "InvocationType": "RequestResponse"
              },
              "ResultPath": "$.venue_result",
              "Retry": [
                {
                  "ErrorEquals": [
                    "Lambda.ServiceException"
                  ],
                  "IntervalSeconds": 30,
                  "MaxAttempts": 2,
                  "BackoffRate": 2.0
                }
              ],
              "End": true
            }
          }
        },
        {
          "StartAt": "UsersETL",
          "States": {
            "UsersETL": {
              "Type": "Task",
              "Resource": "arn:aws:states:::glue:startJobRun.sync",
              "Parameters": {
                "JobName": "{{USERS_GLUE_JOB}}"
              },
              "ResultPath": "$.users_result",
              "Retry": [
                {
                  "ErrorEquals": [
                    "Glue.AmazonGlueException"
                  ],
                  "IntervalSeconds": 60,
                  "MaxAttempts": 1,
                  "BackoffRate": 2.0
                }
              ],
              "End": true
            }
          }
        },
        {
          "StartAt": "EventsETL",
          "States": {
            "EventsETL": {
              "Type": "Task",
              "Resource": "arn:aws:states:::glue:startJobRun.sync",
              "Parameters": {
                "JobName": "{{EVENTS_GLUE_JOB}}"
              },
              "ResultPath": "$.events_result",
              "Retry": [
                {
                  "ErrorEquals": [
                    "Glue.AmazonGlueException"
                  ],
                  "IntervalSeconds": 60,
                  "MaxAttempts": 1,
                  "BackoffRate": 2.0
                }
              ],
              "End": true
            }
          }
        },
        {
          "StartAt": "ListingsETL",
          "States": {
            "ListingsETL": {
              "Type": "Task",
              "Resource": "arn:aws:states:::glue:startJobRun.sync",
              "Parameters": {
                "JobName": "{{LISTINGS_GLUE_JOB}}"
              },
              "ResultPath": "$.listings_result",
              "Retry": [
                {
                  "ErrorEquals": [
                    "Glue.AmazonGlueException"
                  ],
                  "IntervalSeconds": 60,
                  "MaxAttempts": 1,
                  "BackoffRate": 2.0
                }
              ],
              "End": true
            }
          }
        },
        {
          "StartAt": "SalesETL",
          "States": {
            "SalesETL": {
              "Type": "Task",
              "Resource": "arn:aws:states:::glue:startJobRun.sync",
              "Parameters": {
                "JobName": "{{SALES_GLUE_JOB}}"
              },
              "ResultPath": "$.sales_result",
              "Retry": [
                {
                  "ErrorEquals": [
                    "Glue.AmazonGlueException"
                  ],
                  "IntervalSeconds": 60,
                  "MaxAttempts": 1,
                  "BackoffRate": 2.0
                }
              ],
              "End": true
            }
          }
        }
      ],
      "ResultPath": "$.etl_results",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "NotifyETLFailed"
        }
      ],
      "Next": "LoadStaging"
    },
    "LoadStaging": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:redshiftdata:executeStatement",
      "Parameters": {
        "Database": "{{REDSHIFT_DATABASE}}",
        "WorkgroupName": "{{REDSHIFT_WORKGROUP}}",
        "Sql": "CALL sp_load_staging('{{S3_BUCKET}}', '{{REDSHIFT_COPY_ROLE_ARN}}')"
      },
      "ResultPath": "$.staging_exec",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "NotifyStagingFailed"
        }
      ],
      "Next": "WaitForStaging"
    },
    "WaitForStaging": {
      "Type": "Wait",
      "Seconds": "{{WAIT_STAGING_SECONDS}}",
      "Next": "CheckStagingStatus"
    },
    "CheckStagingStatus": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:redshiftdata:describeStatement",
      "Parameters": {
        "Id.$": "$.staging_exec.Id"
      },
      "ResultPath": "$.staging_status",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "NotifyStagingFailed"
        }
      ],
      "Next": "IsStagingDone",
      "Retry": [
        {
          "ErrorEquals": [
            "RedshiftData.ThrottlingException",
            "RedshiftData.InternalServerException",
            "States.TaskFailed"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ]
    },
    "IsStagingDone": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.staging_status.Status",
          "StringEquals": "FINISHED",
          "Next": "LoadDimensions"
        },
        {
          "Variable": "$.staging_status.Status",
          "StringEquals": "FAILED",
          "Next": "CaptureStagingFailure"
        },
        {
          "Variable": "$.staging_status.Status",
          "StringEquals": "ABORTED",
          "Next": "CaptureStagingFailure"
        }
      ],
      "Default": "WaitForStaging"
    },
    "LoadDimensions": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:redshiftdata:executeStatement",
      "Parameters": {
        "Database": "{{REDSHIFT_DATABASE}}",
        "WorkgroupName": "{{REDSHIFT_WORKGROUP}}",
        "Sql": "CALL sp_load_dimensions(CURRENT_DATE)"
      },
      "ResultPath": "$.dim_exec",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "NotifyDimensionsFailed"
        }
      ],
      "Next": "WaitForDimensions"
    },
    "WaitForDimensions": {
      "Type": "Wait",
      "Seconds": "{{WAIT_DIMENSIONS_SECONDS}}",
      "Next": "CheckDimensionsStatus"
    },
    "CheckDimensionsStatus": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:redshiftdata:describeStatement",
      "Parameters": {
        "Id.$": "$.dim_exec.Id"
      },
      "ResultPath": "$.dim_status",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "NotifyDimensionsFailed"
        }
      ],
      "Next": "IsDimensionsDone",
      "Retry": [
        {
          "ErrorEquals": [
            "RedshiftData.ThrottlingException",
            "RedshiftData.InternalServerException",
            "States.TaskFailed"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ]
    },
    "IsDimensionsDone": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.dim_status.Status",
          "StringEquals": "FINISHED",
          "Next": "LoadFacts"
        },
        {
          "Variable": "$.dim_status.Status",
          "StringEquals": "FAILED",
          "Next": "CaptureDimensionsFailure"
        },
        {
          "Variable": "$.dim_status.Status",
          "StringEquals": "ABORTED",
          "Next": "CaptureDimensionsFailure"
        }
      ],
      "Default": "WaitForDimensions"
    },
    "LoadFacts": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:redshiftdata:executeStatement",
      "Parameters": {
        "Database": "{{REDSHIFT_DATABASE}}",
        "WorkgroupName": "{{REDSHIFT_WORKGROUP}}",
        "Sql": "CALL sp_load_facts(CURRENT_DATE)"
      },
      "ResultPath": "$.fact_exec",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "NotifyFactsFailed"
        }
      ],
      "Next": "WaitForFacts"
    },
    "WaitForFacts": {
      "Type": "Wait",
      "Seconds": "{{WAIT_FACTS_SECONDS}}",
      "Next": "CheckFactsStatus"
    },
    "CheckFactsStatus": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:redshiftdata:describeStatement",
      "Parameters": {
        "Id.$": "$.fact_exec.Id"
      },
      "ResultPath": "$.fact_status",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "NotifyFactsFailed"
        }
      ],
      "Next": "IsFactsDone",
      "Retry": [
        {
          "ErrorEquals": [
            "RedshiftData.ThrottlingException",
            "RedshiftData.InternalServerException",
            "States.TaskFailed"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ]
    },
    "IsFactsDone": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.fact_status.Status",
          "StringEquals": "FINISHED",
          "Next": "NotifySuccess"
        },
        {
          "Variable": "$.fact_status.Status",
          "StringEquals": "FAILED",
          "Next": "CaptureFactsFailure"
        },
        {
          "Variable": "$.fact_status.Status",
          "StringEquals": "ABORTED",
          "Next": "CaptureFactsFailure"
        }
      ],
      "Default": "WaitForFacts"
    },
    "NotifySuccess": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "{{SNS_TOPIC_ARN}}",
        "Subject": "TICKIT Pipeline SUCCESS",
        "Message": "TICKIT V2 completed: six ETL branches, Redshift staging, initial/idempotent dimensions and facts. Full SCD Type 2 change tracking is not yet implemented."
      },
      "Next": "PipelineSuccess",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "PipelineFailed"
        }
      ]
    },
    "NotifyETLFailed": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "{{SNS_TOPIC_ARN}}",
        "Subject": "TICKIT Pipeline FAILED - ETL",
        "Message.$": "States.JsonToString($.error)"
      },
      "Next": "PipelineFailed",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "PipelineFailed"
        }
      ]
    },
    "NotifyStagingFailed": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "{{SNS_TOPIC_ARN}}",
        "Subject": "TICKIT Pipeline FAILED - Staging",
        "Message.$": "States.JsonToString($.error)"
      },
      "Next": "PipelineFailed",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "PipelineFailed"
        }
      ]
    },
    "NotifyDimensionsFailed": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "{{SNS_TOPIC_ARN}}",
        "Subject": "TICKIT Pipeline FAILED - Dimensions",
        "Message.$": "States.JsonToString($.error)"
      },
      "Next": "PipelineFailed",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "PipelineFailed"
        }
      ]
    },
    "NotifyFactsFailed": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "{{SNS_TOPIC_ARN}}",
        "Subject": "TICKIT Pipeline FAILED - Facts",
        "Message.$": "States.JsonToString($.error)"
      },
      "Next": "PipelineFailed",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "PipelineFailed"
        }
      ]
    },
    "PipelineSuccess": {
      "Type": "Succeed"
    },
    "PipelineFailed": {
      "Type": "Fail",
      "Error": "PipelineError",
      "Cause": "One or more stages failed"
    },
    "CaptureStagingFailure": {
      "Type": "Pass",
      "Parameters": {
        "Error": "RedshiftStatementFailed",
        "stage": "staging",
        "status.$": "$.staging_status.Status",
        "statement_id.$": "$.staging_exec.Id"
      },
      "ResultPath": "$.error",
      "Next": "NotifyStagingFailed"
    },
    "CaptureDimensionsFailure": {
      "Type": "Pass",
      "Parameters": {
        "Error": "RedshiftStatementFailed",
        "stage": "dimensions",
        "status.$": "$.dim_status.Status",
        "statement_id.$": "$.dim_exec.Id"
      },
      "ResultPath": "$.error",
      "Next": "NotifyDimensionsFailed"
    },
    "CaptureFactsFailure": {
      "Type": "Pass",
      "Parameters": {
        "Error": "RedshiftStatementFailed",
        "stage": "facts",
        "status.$": "$.fact_status.Status",
        "statement_id.$": "$.fact_exec.Id"
      },
      "ResultPath": "$.error",
      "Next": "NotifyFactsFailed"
    }
  },
  "TimeoutSeconds": "{{WORKFLOW_TIMEOUT_SECONDS}}"
}
